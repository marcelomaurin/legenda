# Legenda v2 - exemplo Nginx.
# Requer certificado configurado para o hostname real.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name legenda.exemplo.gov.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name legenda.exemplo.gov.br;

    ssl_certificate     /etc/letsencrypt/live/legenda.exemplo.gov.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/legenda.exemplo.gov.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/legenda/web;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8098/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location /orchestrator-api/ {
        proxy_pass http://127.0.0.1:8070/;
        proxy_set_header Host $host;
    }

    location /fleet-api/ {
        proxy_pass http://127.0.0.1:8050/;
        proxy_set_header Host $host;
    }

    location /corpus-api/ {
        proxy_pass http://127.0.0.1:8060/;
        proxy_set_header Host $host;
        client_max_body_size 20m;
    }
}

# Não publique 8097/TCP via Internet. Restrinja por firewall/VPN.
